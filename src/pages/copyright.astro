---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const copyrightPost = await getEntry("spec", "copyright");

if (!copyrightPost) {
	throw new Error("Copyright page content not found");
}

const { Content } = await render(copyrightPost);
---
<MainGridLayout title="版权声明" description="本站原创内容采用 CC BY-NC-SA 4.0 协议授权">
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>