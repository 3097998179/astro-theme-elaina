    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('fileInput');
            const fileName = document.getElementById('fileName');
            const previewContainer = document.getElementById('previewContainer');
            const previewImg = document.getElementById('previewImg');
            const previewFileName = document.getElementById('previewFileName');
            const previewDimensions = document.getElementById('previewDimensions');
            const dropArea = document.getElementById('dropArea');
            const uploadForm = document.getElementById('uploadForm');

            // 文件选择事件
            fileInput.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    
                    // 更新文件名显示
                    fileName.textContent = file.name;
                    fileName.style.color = '#48bb78';
                    
                    // 显示预览
                    showImagePreview(file);
                } else {
                    hideImagePreview();
                }
            });

            // 拖放功能
            dropArea.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.style.borderColor = '#667eea';
                this.style.background = '#f0f4ff';
            });

            dropArea.addEventListener('dragleave', function(e) {
                e.preventDefault();
                this.style.borderColor = '#cbd5e0';
                this.style.background = 'transparent';
            });

            dropArea.addEventListener('drop', function(e) {
                e.preventDefault();
                this.style.borderColor = '#cbd5e0';
                this.style.background = 'transparent';
                
                const files = e.dataTransfer.files;
                if (files && files[0]) {
                    fileInput.files = files;
                    const file = files[0];
                    
                    fileName.textContent = file.name;
                    fileName.style.color = '#48bb78';
                    
                    showImagePreview(file);
                    fileInput.dispatchEvent(new Event('change'));
                }
            });

            function showImagePreview(file) {
                // 检查文件类型
                if (!file.type.match('image.*')) {
                    hideImagePreview();
                    return;
                }

                // 显示预览容器
                previewContainer.style.display = 'block';
                previewFileName.textContent = file.name;
                previewDimensions.textContent = '加载中...';

                // 使用FileReader读取文件
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    
                    // 创建图片对象获取尺寸
                    const img = new Image();
                    img.onload = function() {
                        previewDimensions.textContent = this.width + ' × ' + this.height + ' 像素';
                        
                        // 检查尺寸
                        if (this.width < 16 || this.height < 16) {
                            previewDimensions.innerHTML += '<br><span style="color:#f56565;">⚠️ 图片尺寸过小</span>';
                        }
                    };
                    img.onerror = function() {
                        previewDimensions.textContent = '未知尺寸';
                    };
                    img.src = e.target.result;
                };
                
                reader.onerror = hideImagePreview;
                reader.readAsDataURL(file);
            }

            function hideImagePreview() {
                previewContainer.style.display = 'none';
                previewImg.src = '';
                previewFileName.textContent = '-';
                previewDimensions.textContent = '-';
                fileName.textContent = '未选择文件';
                fileName.style.color = '#718096';
            }

            // 初始隐藏预览容器
            hideImagePreview();
        });

        // 更新进度条
        function updateProgress(percent, status) {
            const progressFill = document.getElementById('progressFill');
            const progressPercent = document.getElementById('progressPercent');
            const progressStatus = document.getElementById('progressStatus');
            
            if (progressFill) {
                progressFill.style.width = percent + '%';
                progressPercent.textContent = percent + '%';
                progressStatus.textContent = status;
            }
        }

        // 表单提交函数
        function submitForm() {
            const fileInput = document.getElementById('fileInput');
            const convertBtn = document.getElementById('convertBtn');
            const progressContainer = document.getElementById('progressContainer');
            const maxSize = 10485760;
            
            if (!fileInput.files || !fileInput.files[0]) {
                alert('请先选择一个图片文件！');
                return false;
            }
            
            const file = fileInput.files[0];
            
            // 验证文件类型
            const reg = /(gif|png|jpe?g|bmp|tiff?)$/i;
            if (!reg.test(file.name)) {
                alert('抱歉，目前只支持 JPEG, PNG, GIF 和 BMP 格式的图片');
                return false;
            }
            
            // 验证文件大小
            if (file.size > maxSize) {
                const maxMB = (maxSize / (1024 * 1024)).toFixed(1);
                const actualMB = (file.size / (1024 * 1024)).toFixed(1);
                alert('文件太大！\n\n您选择的文件：' + actualMB + ' MB\n最大允许：' + maxMB + ' MB');
                return false;
            }
            
            // 显示进度条
            if (progressContainer) {
                progressContainer.style.display = 'block';
                updateProgress(10, '正在验证文件...');
            }
            
            // 禁用转换按钮
            if (convertBtn) {
                convertBtn.disabled = true;
                convertBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 转换中...';
            }
            
            // 模拟进度更新
            let progress = 10;
            const progressInterval = setInterval(() => {
                progress += 10;
                if (progress <= 90) {
                    const status = progress < 50 ? '正在上传文件...' : 
                                 progress < 80 ? '正在处理图片...' : 
                                 '正在生成图标...';
                    updateProgress(progress, status);
                } else {
                    clearInterval(progressInterval);
                    updateProgress(100, '转换完成！即将跳转...');
                }
            }, 500);
            
            // 表单会自动提交
            return true;
        }

        // 重置表单 - 修复版
        function resetForm() {
            const uploadForm = document.getElementById('uploadForm');
            const downloadSection = document.getElementById('downloadSection');
            const convertBtn = document.getElementById('convertBtn');
            const progressContainer = document.getElementById('progressContainer');
            
            // 完全重置表单
            if (uploadForm) {
                uploadForm.reset();
                // 确保表单可见
                uploadForm.style.display = 'block';
                // 重置文件输入
                const fileInput = document.getElementById('fileInput');
                if (fileInput) {
                    fileInput.value = '';
                }
            }
            
            // 隐藏下载区域
            if (downloadSection) {
                downloadSection.style.display = 'none';
                downloadSection.innerHTML = '';
            }
            
            // 重置转换按钮
            if (convertBtn) {
                convertBtn.disabled = false;
                convertBtn.innerHTML = '<i class="fas fa-magic"></i> 开始转换';
            }
            
            // 隐藏进度条
            if (progressContainer) {
                progressContainer.style.display = 'none';
            }
            
            // 隐藏预览
            hideImagePreview();
            
            // 清除所有消息
            const messages = document.querySelectorAll('.message');
            messages.forEach(msg => msg.remove());
            
            // 重新加载页面（最可靠的方式）
            window.location.href = '/index.php';
        }
        
        // 辅助函数
        function hideImagePreview() {
            const previewContainer = document.getElementById('previewContainer');
            const fileName = document.getElementById('fileName');
            
            if (previewContainer) {
                previewContainer.style.display = 'none';
            }
            if (fileName) {
                fileName.textContent = '未选择文件';
                fileName.style.color = '#718096';
            }
        }

        // ============ 新增：分享功能JavaScript代码 ============
        // 获取当前页面URL和标题
        const currentPageUrl = encodeURIComponent(window.location.href);
        const pageTitle = encodeURIComponent(document.title);
        const pageDescription = encodeURIComponent("免费在线ICO图标转换工具，支持JPG、PNG、GIF、BMP转换为ICO格式，生成多尺寸网站favicon和软件图标");

        // 分享到微博
        function shareToWeibo() {
            const url = `http://service.weibo.com/share/share.php?url=${currentPageUrl}&title=${pageTitle}&appkey=&pic=`;
            window.open(url, '_blank', 'width=550,height=400');
        }

        // 分享到QQ
        function shareToQQ() {
            const url = `https://connect.qq.com/widget/shareqq/index.html?url=${currentPageUrl}&title=${pageTitle}&summary=${pageDescription}&site=大魔头ICO转换工具`;
            window.open(url, '_blank', 'width=550,height=400');
        }

        // 分享到QQ空间
        function shareToQZone() {
            const url = `https://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?url=${currentPageUrl}&title=${pageTitle}&summary=${pageDescription}&site=大魔头ICO转换工具`;
            window.open(url, '_blank', 'width=550,height=400');
        }

        // 分享到豆瓣
        function shareToDouban() {
            const url = `https://www.douban.com/share/service?url=${currentPageUrl}&title=${pageTitle}&image=&content=${pageDescription}`;
            window.open(url, '_blank', 'width=550,height=400');
        }

        // 分享到Twitter
        function shareToTwitter() {
            const url = `https://twitter.com/intent/tweet?url=${currentPageUrl}&text=${pageTitle}&via=damotou`;
            window.open(url, '_blank', 'width=550,height=400');
        }

        // 分享到Facebook
        function shareToFacebook() {
            const url = `https://www.facebook.com/sharer/sharer.php?u=${currentPageUrl}&quote=${pageTitle}`;
            window.open(url, '_blank', 'width=550,height=400');
        }

        // 显示微信二维码
        function showWechatQRCode() {
            const modal = document.getElementById('wechatQRCodeModal');
            const qrcodeContainer = document.getElementById('wechatQRCode');
            
            // 清空之前的二维码
            qrcodeContainer.innerHTML = '';
            
            // 创建二维码
            const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${currentPageUrl}`;
            const img = document.createElement('img');
            img.src = qrCodeUrl;
            img.alt = '微信分享二维码';
            img.style.width = '100%';
            img.style.height = '100%';
            img.onload = function() {
                qrcodeContainer.innerHTML = '';
                qrcodeContainer.appendChild(img);
            };
            
            // 显示模态框
            modal.style.display = 'flex';
        }

        // 关闭微信二维码
        function closeWechatQRCode() {
            const modal = document.getElementById('wechatQRCodeModal');
            modal.style.display = 'none';
        }

        // 复制链接到剪贴板
        function copyToClipboard() {
            const textToCopy = window.location.href;
            
            // 使用现代剪贴板API
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(textToCopy)
                    .then(() => {
                        showCopySuccess();
                    })
                    .catch(err => {
                        fallbackCopyTextToClipboard(textToCopy);
                    });
            } else {
                // 降级方案
                fallbackCopyTextToClipboard(textToCopy);
            }
        }

        function fallbackCopyTextToClipboard(text) {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            
            // 避免滚动到底部
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.position = "fixed";

            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();

            try {
                const successful = document.execCommand('copy');
                if (successful) {
                    showCopySuccess();
                } else {
                    alert('复制失败，请手动复制链接：' + text);
                }
            } catch (err) {
                alert('复制失败，请手动复制链接：' + text);
            }

            document.body.removeChild(textArea);
        }

        function showCopySuccess() {
            // 创建提示消息
            const message = document.createElement('div');
            message.textContent = '链接已复制到剪贴板！';
            message.style.position = 'fixed';
            message.style.top = '50%';
            message.style.left = '50%';
            message.style.transform = 'translate(-50%, -50%)';
            message.style.backgroundColor = 'rgba(0,0,0,0.8)';
            message.style.color = 'white';
            message.style.padding = '15px 30px';
            message.style.borderRadius = '8px';
            message.style.zIndex = '9999';
            message.style.fontSize = '16px';
            message.style.boxShadow = '0 5px 15px rgba(0,0,0,0.3)';
            
            document.body.appendChild(message);
            
            // 2秒后移除提示
            setTimeout(() => {
                document.body.removeChild(message);
            }, 2000);
        }

        // 点击模态框外部关闭
        document.getElementById('wechatQRCodeModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeWechatQRCode();
            }
        });
        // ============ 分享功能JavaScript代码结束 ============
    </script>
    
